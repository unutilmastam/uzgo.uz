# /opt/uzgo/api.env — API secrets (compose.prod.yml env_file). Placeholders only.
# chmod 600; never commit the real file. Full reference: apps/api/.env.example.
# DATABASE_URL, CORS_ORIGINS, WEB_PUBLIC_URL, TRUST_PROXY and storage are set
# by compose.prod.yml from .env.

LOG_LEVEL=info
# openssl rand -base64 48
AUTH_SECRET=replace-with-at-least-32-random-characters
# openssl rand -base64 32 (exactly 32 bytes). Losing it = staff re-enrol TOTP.
TOTP_ENCRYPTION_KEY=replace-with-32-random-bytes-base64
STAFF_TOTP_REQUIRED=true

# SMS (Eskiz.uz)
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=replace-me@example.uz
ESKIZ_PASSWORD=replace-me
ESKIZ_FROM=4546

# Payments (ADR 0017) — a method is offered only when its keys are set.
PAYMENT_WINDOW_MINUTES=30
# PAYME_MERCHANT_ID=
# PAYME_KEY=
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_MERCHANT_USER_ID=
# CLICK_SECRET_KEY=

# Ledger (ADR 0018)
COMMISSION_DEFAULT_BP=0
PAYOUT_HOLD_DAYS=10
RETURN_WINDOW_DAYS=10

# Telegram: seller notifications + ops alerts (ADR 0019/0020)
# TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=

# ─── UZGO Food (ADR 0024) ───────────────────────────────────────────────────
# Courier tariff in tiyin (8 000 soʻm + 2 000 soʻm per km of road) — owner decision.
FOOD_COURIER_BASE_TIYIN=800000
FOOD_COURIER_PER_KM_TIYIN=200000
FOOD_OFFER_RADIUS_KM=5
FOOD_ACCEPT_TIMEOUT_MINUTES=10
# OpenStreetMap address search; the contact e-mail goes into the User-Agent.
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODER_CONTACT=ops@example.uz
