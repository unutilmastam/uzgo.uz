# /opt/uzgo/.env — stack settings for compose.prod.yml. Placeholders only.
# chmod 600; never commit the real file.

# Public domain (no scheme). Changing it = edit this + DNS A/AAAA records.
UZGO_DOMAIN=example.uz
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=ops@example.uz
# Leave empty in production. "tls internal" only for local/CI smoke tests.
CADDY_TLS=

# Images (set by deploy.sh). Registry: ghcr.io/<github-owner>/uzgo
UZGO_REGISTRY=ghcr.io/<github-owner>/uzgo
UZGO_TAG=<commit-sha>

# Database password: URL-safe random hex, e.g. `openssl rand -hex 32`.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

# Search engines: true only after launch.
PUBLIC_INDEXING=false
