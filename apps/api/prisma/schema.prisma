// UZGO — the only Prisma schema (see docs/decisions/0002-prisma-in-api.md).
// Conventions: docs/DATABASE.md (UUID v7 ids, timestamptz, Json per-locale names).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// The pg_trgm extension is created in a migration (product search).
datasource db {
  provider = "postgresql"
}

// ─── Geography (reference data, seeded) ────────────────────────────────────

enum RegionKind {
  REGION // viloyat
  REPUBLIC // Qoraqalpogʻiston Respublikasi
  CITY // Toshkent shahri
}

enum DistrictKind {
  DISTRICT // tuman
  CITY // city of regional significance
}

model Region {
  id        String     @id @default(uuid(7)) @db.Uuid
  /// ISO 3166-2 code, e.g. UZ-SU
  code      String     @unique
  slug      String     @unique
  kind      RegionKind
  /// { "uz": "...", "ru": "..." }
  name      Json
  sort      Int
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)
  districts District[]
}

model District {
  id           String        @id @default(uuid(7)) @db.Uuid
  regionId     String        @db.Uuid
  region       Region        @relation(fields: [regionId], references: [id], onDelete: Restrict)
  slug         String        @unique
  kind         DistrictKind
  name         Json
  sort         Int
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  profiles     UserProfile[]
  stores       Store[]
  orders       Order[]
  deliveryZone DeliveryZone?
  pickupPoints PickupPoint[]

  @@index([regionId, sort])
}

// ─── Users, roles, sessions ────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum Role {
  CUSTOMER
  SELLER_OWNER // store-scoped via membership (Phase 5)
  SELLER_STAFF // store-scoped via membership (Phase 5)
  MODERATOR
  ADMIN
  SUPER_ADMIN
  /// UZGO Food courier (Phase 9b, ADR 0024); granted by staff with a CourierProfile.
  COURIER
  /// UZGO Go driver (Phase 9c, ADR 0025); granted when staff approve a DriverProfile.
  DRIVER
}

model User {
  id                 String              @id @default(uuid(7)) @db.Uuid
  /// E.164, e.g. +998901234567
  phone              String              @unique
  status             UserStatus          @default(ACTIVE)
  locale             String              @default("uz")
  lastLoginAt        DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?           @db.Timestamptz(3)
  profile            UserProfile?
  roles              UserRole[]          @relation("UserRoles")
  rolesGranted       UserRole[]          @relation("RoleGrantedBy")
  sessions           Session[]
  pushDevices        PushDevice[]
  reviews            ProductReview[]
  favorites          Favorite[]
  auditEvents        AuditEvent[]
  storeMembers       StoreMember[]
  cart               Cart?
  orders             Order[]
  orderEvents        OrderEvent[]
  idempotencyKeys    IdempotencyKey[]
  staffTotps         StaffTotp[]
  courierProfile     CourierProfile?
  courierOrders      SellerOrder[]       @relation("CourierOrders")
  courierLedger      LedgerEntry[]       @relation("CourierLedger")
  courierSettlements CourierSettlement[] @relation("SettlementCourier")
  driverProfile      DriverProfile?
  ridesTaken         Ride[]              @relation("RideRider")
  ridesDriven        Ride[]              @relation("RideDriver")
  driverLedger       LedgerEntry[]       @relation("DriverLedger")
  driverSettlements  DriverSettlement[]  @relation("SettlementDriver")
}

model UserProfile {
  userId     String    @id @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName  String?
  lastName   String?
  districtId String?   @db.Uuid
  district   District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@index([districtId])
}

model UserRole {
  userId      String   @db.Uuid
  user        User     @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role        Role
  grantedById String?  @db.Uuid
  grantedBy   User?    @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, role])
  @@index([grantedById])
}

model Session {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the opaque token; the token itself is never stored.
  tokenHash      String       @unique
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  lastSeenAt     DateTime     @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime     @db.Timestamptz(3)
  revokedAt      DateTime?    @db.Timestamptz(3)
  /// When this session passed the staff second factor (TOTP).
  totpVerifiedAt DateTime?    @db.Timestamptz(3)
  /// HMAC of the client IP (privacy: raw IPs are not stored).
  ipHash         String?
  userAgent      String?
  pushDevices    PushDevice[]

  @@index([userId])
  @@index([expiresAt])
}

enum PushPlatform {
  IOS
  ANDROID
}

/// A phone that receives push notifications. Bound to the login session, so
/// logging out (or revoking the session) stops pushes to that phone.
model PushDevice {
  id        String       @id @default(uuid(7)) @db.Uuid
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String       @db.Uuid
  session   Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Expo push token ("ExponentPushToken[…]").
  token     String       @unique
  platform  PushPlatform
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@index([sessionId])
}

model OtpCode {
  id         String    @id @default(uuid(7)) @db.Uuid
  phone      String
  /// HMAC-SHA256(secret, phone:code); the code itself is never stored.
  codeHash   String
  expiresAt  DateTime  @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @db.Timestamptz(3)
  ipHash     String
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@index([ipHash, createdAt])
}

/// Staff second factor (RFC 6238 TOTP). The secret is encrypted (AES-256-GCM).
model StaffTotp {
  userId          String    @id @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEncrypted String
  enabledAt       DateTime? @db.Timestamptz(3)
  /// Last accepted 30-second time step (codes cannot be replayed).
  lastUsedStep    BigInt?
  failedAttempts  Int       @default(0)
  lockedUntil     DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
}

// ─── Audit (append-only; UPDATE/DELETE blocked by a trigger) ────────────────

model AuditEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  /// e.g. auth.login, auth.logout, role.granted
  action     String
  entityType String
  entityId   String?
  /// Masked details only — never secrets, codes or full phone numbers.
  metadata   Json?
  ipHash     String?
  requestId  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

// ─── Catalog (Phase 4) ─────────────────────────────────────────────────────

model Category {
  id           String              @id @default(uuid(7)) @db.Uuid
  parentId     String?             @db.Uuid
  parent       Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]          @relation("CategoryTree")
  slug         String              @unique
  /// { "uz": "...", "ru": "..." }
  name         Json
  /// Icon name used by the web app (lucide), e.g. "smartphone"
  icon         String?
  sort         Int                 @default(0)
  active       Boolean             @default(true)
  /// Marketplace commission in basis points (1000 = 10 %); null = inherit from the parent / default.
  commissionBp Int?
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)
  attributes   CategoryAttribute[]
  products     Product[]

  @@index([parentId, sort])
}

enum AttributeType {
  SELECT
}

model Attribute {
  id         String              @id @default(uuid(7)) @db.Uuid
  code       String              @unique
  name       Json
  type       AttributeType       @default(SELECT)
  sort       Int                 @default(0)
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @db.Timestamptz(3)
  values     AttributeValue[]
  categories CategoryAttribute[]
}

model AttributeValue {
  id          String                  @id @default(uuid(7)) @db.Uuid
  attributeId String                  @db.Uuid
  attribute   Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  code        String
  name        Json
  sort        Int                     @default(0)
  createdAt   DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                @updatedAt @db.Timestamptz(3)
  products    ProductAttributeValue[]
  variants    VariantAttributeValue[]

  @@unique([attributeId, code])
}

/// Which attributes a category uses for filters (inherited by its children).
model CategoryAttribute {
  categoryId  String    @db.Uuid
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attributeId String    @db.Uuid
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  sort        Int       @default(0)

  @@id([categoryId, attributeId])
  @@index([attributeId])
}

// ─── Stores and products (Phase 4) ─────────────────────────────────────────

enum StoreStatus {
  PENDING // application submitted, awaiting admin review
  ACTIVE
  REJECTED
  SUSPENDED
}

enum LegalType {
  INDIVIDUAL_ENTREPRENEUR // YaTT / ИП
  LEGAL_ENTITY // MChJ etc.
}

enum StoreKind {
  SHOP
  /// UZGO Food restaurant (Phase 9b): added by staff, never in the marketplace.
  RESTAURANT
}

model Store {
  id              String             @id @default(uuid(7)) @db.Uuid
  kind            StoreKind          @default(SHOP)
  slug            String             @unique
  name            Json
  description     Json?
  status          StoreStatus        @default(PENDING)
  /// Demo stores (seeded fixtures) are labelled "Demo" everywhere in the UI.
  isDemo          Boolean            @default(false)
  districtId      String?            @db.Uuid
  district        District?          @relation(fields: [districtId], references: [id], onDelete: SetNull)
  logoKey         String?
  /// Seller details from the application (fields only; verified manually by staff).
  legalType       LegalType?
  legalName       String?
  /// STIR / INN (9 digits) of the entity or entrepreneur.
  taxId           String?
  contactPhone    String?
  reviewedAt      DateTime?          @db.Timestamptz(3)
  reviewedById    String?            @db.Uuid
  reviewNote      String?
  /// Commission override for this store (basis points); null = category rules.
  commissionBp    Int?
  /// Payout bank details (owner-managed). Account: 20 digits; MFO (bank code): 5 digits.
  payoutBankName  String?
  payoutMfo       String?
  payoutAccount   String?
  payoutRecipient String?
  /// Telegram chat that receives new-order notifications (set by the owner).
  telegramChatId  String?
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?          @db.Timestamptz(3)
  members         StoreMember[]
  products        Product[]
  variants        ProductVariant[]
  sellerOrders    SellerOrder[]
  ledgerEntries   LedgerEntry[]
  payouts         Payout[]
  restaurant      RestaurantProfile?
  menuCategories  FoodMenuCategory[]
  menuItems       FoodMenuItem[]

  @@index([status])
  @@index([kind, status])
  @@index([districtId])
}

enum StoreRole {
  OWNER
  STAFF
}

/// Store-scoped seller roles (SPEC §9). Seller isolation is checked against this table.
model StoreMember {
  storeId   String    @db.Uuid
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      StoreRole
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@id([storeId, userId])
  @@index([userId])
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

model Product {
  id             String                   @id @default(uuid(7)) @db.Uuid
  storeId        String                   @db.Uuid
  store          Store                    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  categoryId     String                   @db.Uuid
  category       Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  slug           String                   @unique
  title          Json
  description    Json
  status         ProductStatus            @default(DRAFT)
  /// Moderator note shown to the seller (e.g. rejection reason).
  moderationNote String?
  submittedAt    DateTime?                @db.Timestamptz(3)
  reviewedAt     DateTime?                @db.Timestamptz(3)
  /// Normalised text for search (uz + ru titles, Latin/Cyrillic folded, apostrophes removed).
  searchText     String                   @default("")
  /// GENERATED ALWAYS AS (to_tsvector('simple', "searchText")) STORED — see migration.
  searchVector   Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, \"searchText\")"))
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?                @db.Timestamptz(3)
  /// Published review aggregates (kept in the same transaction as reviews, Phase 9a).
  ratingCount    Int                      @default(0)
  ratingSum      Int                      @default(0)
  variants       ProductVariant[]
  images         ProductImage[]
  attributes     ProductAttributeValue[]
  reviews        ProductReview[]
  favorites      Favorite[]

  @@index([status, categoryId])
  @@index([storeId, status])
  @@index([categoryId])
  @@index([searchVector], type: Gin)
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Product-level attribute values (e.g. brand) used for filters.
model ProductAttributeValue {
  productId        String         @db.Uuid
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValueId String         @db.Uuid
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([productId, attributeValueId])
  @@index([attributeValueId])
}

/// SKU: price, stock and fiscal data live on the variant (SPEC §10).
model ProductVariant {
  id                  String                  @id @default(uuid(7)) @db.Uuid
  productId           String                  @db.Uuid
  product             Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Denormalised from Product so SKUs are unique per store.
  storeId             String                  @db.Uuid
  store               Store                   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  sku                 String
  barcode             String?
  /// Integer tiyin (1 soʻm = 100 tiyin).
  priceTiyin          BigInt
  compareAtPriceTiyin BigInt?
  stock               Int                     @default(0)
  /// MXIK / IKPU product classification code (17 digits). Required before online payments.
  mxikCode            String?
  packageCode         String?
  /// VAT in basis points, e.g. 1200 = 12 %.
  vatRateBp           Int?
  active              Boolean                 @default(true)
  sort                Int                     @default(0)
  createdAt           DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @db.Timestamptz(3)
  options             VariantAttributeValue[]
  cartItems           CartItem[]
  orderItems          OrderItem[]

  @@unique([storeId, sku])
  @@index([productId])
  @@index([priceTiyin])
}

/// Variant options (e.g. colour, size, memory).
model VariantAttributeValue {
  variantId        String         @db.Uuid
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValueId String         @db.Uuid
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
}

model ProductImage {
  id         String   @id @default(uuid(7)) @db.Uuid
  productId  String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Random object-storage key; never a user-supplied path.
  storageKey String   @unique
  sort       Int      @default(0)
  alt        Json?
  width      Int?
  height     Int?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([productId, sort])
}

// ─── Cart (Phase 4e) ───────────────────────────────────────────────────────

/// One cart per user, or a guest cart identified by a hashed cookie token.
/// Prices are never stored here: they are recalculated on every read.
model Cart {
  id             String     @id @default(uuid(7)) @db.Uuid
  userId         String?    @unique @db.Uuid
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the guest cart cookie token.
  guestTokenHash String?    @unique
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)
  items          CartItem[]

  @@index([updatedAt])
}

model CartItem {
  id        String         @id @default(uuid(7)) @db.Uuid
  cartId    String         @db.Uuid
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String         @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([cartId, variantId])
  @@index([variantId])
}

// ─── Orders (Phase 4f) — never deleted (trigger) ───────────────────────────

enum OrderStatus {
  AWAITING_PAYMENT // online payment not received yet (stock is held until paymentDueAt)
  CREATED // cash/card on delivery, waiting for sellers
  CONFIRMED // at least one seller accepted
  COMPLETED // every shipment resolved
  CANCELLED // every shipment cancelled
}

enum SellerOrderStatus {
  PENDING_PAYMENT // hidden from the seller until the order is paid
  NEW
  ACCEPTED
  PACKED
  HANDED_TO_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  CANCELLED_BY_SELLER
  CANCELLED_BY_CUSTOMER
  RETURN_REQUESTED
  RETURNED
  RETURN_REJECTED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  PAYME
  CLICK
  /// DEVELOPMENT / TESTS ONLY: simulated online payment, refused in production.
  DEV_ONLINE
}

enum PaymentStatus {
  PENDING // provider transaction created, money not captured yet
  PAID
  CANCELLED // never paid (timeout, declined, cancelled before capture)
  REFUNDED // captured, then fully returned by the provider
}

/// One provider transaction for an order (Payme transaction, Click payment, dev payment).
/// An order may see several attempts (e.g. a timed-out one, then a successful one).
model PaymentAttempt {
  id            String        @id @default(uuid(7)) @db.Uuid
  /// Numeric reference for providers that need integers (Click merchant_prepare_id).
  seq           BigInt        @unique @default(autoincrement())
  orderId       String        @db.Uuid
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  /// Always equal to the order total at creation (checked against the provider's amount).
  amountTiyin   BigInt
  /// Provider's transaction id (Payme `id`, Click `click_trans_id`); unique per provider.
  providerTxId  String
  /// Provider-specific state, e.g. Payme 1 / 2 / -1 / -2.
  providerState Int?
  /// Provider's own timestamp (Payme `time`, ms).
  providerTime  BigInt?
  performedAt   DateTime?     @db.Timestamptz(3)
  cancelledAt   DateTime?     @db.Timestamptz(3)
  cancelReason  Int?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  refunds       Refund[]

  @@unique([method, providerTxId])
  @@index([orderId])
  @@index([status, createdAt])
}

enum OrderActor {
  CUSTOMER
  SELLER
  ADMIN
  SYSTEM
  COURIER
  DRIVER
}

enum OrderKind {
  MARKET
  FOOD
  /// UZGO Go ride (ADR 0025): no shipments; details in Ride.
  RIDE
}

enum FoodDeliveryMode {
  /// The restaurant delivers with its own courier and fee.
  SELF
  /// A UZGO courier delivers; the fee goes to the courier.
  UZGO
}

/// Customer-facing order; one SellerOrder (shipment) per store (ADR 0006).
model Order {
  id                 String            @id @default(uuid(7)) @db.Uuid
  /// Human-readable, e.g. UZ-2026-000123
  number             String            @unique
  userId             String            @db.Uuid
  user               User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind               OrderKind         @default(MARKET)
  status             OrderStatus       @default(CREATED)
  paymentMethod      PaymentMethod
  /// Online orders: unpaid after this moment are cancelled and their stock released.
  paymentDueAt       DateTime?         @db.Timestamptz(3)
  paidAt             DateTime?         @db.Timestamptz(3)
  itemsTotalTiyin    BigInt
  deliveryTotalTiyin BigInt
  /// Promo discount funded by UZGO (items only), Phase 9a.
  discountTiyin      BigInt            @default(0)
  /// What the customer pays: items + delivery − discount.
  totalTiyin         BigInt
  promoCodeId        String?           @db.Uuid
  promoCode          PromoCode?        @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  recipientName      String
  recipientPhone     String
  districtId         String            @db.Uuid
  district           District          @relation(fields: [districtId], references: [id], onDelete: Restrict)
  addressLine        String
  deliveryType       DeliveryType      @default(COURIER)
  pickupPointId      String?           @db.Uuid
  pickupPoint        PickupPoint?      @relation(fields: [pickupPointId], references: [id], onDelete: Restrict)
  /// Region/district names at order time.
  addressSnapshot    Json
  comment            String?
  /// Food orders: delivery point (WGS 84) and delivery mode snapshot.
  deliveryLat        Float?
  deliveryLng        Float?
  foodDeliveryMode   FoodDeliveryMode?
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  sellerOrders       SellerOrder[]
  events             OrderEvent[]
  payments           PaymentAttempt[]
  refunds            Refund[]
  ride               Ride?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([kind, status, createdAt])
  @@index([districtId])
  @@index([paymentDueAt])
  @@index([promoCodeId, userId])
}

model SellerOrder {
  id                 String            @id @default(uuid(7)) @db.Uuid
  orderId            String            @db.Uuid
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  storeId            String            @db.Uuid
  store              Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  /// e.g. UZ-2026-000123-1
  number             String            @unique
  status             SellerOrderStatus @default(NEW)
  itemsTotalTiyin    BigInt
  deliveryTiyin      BigInt
  /// Items + delivery (the seller's amount, before any promo).
  totalTiyin         BigInt
  /// This shipment's share of the order's promo discount (UZGO pays it to the seller).
  discountTiyin      BigInt            @default(0)
  /// Marketplace commission for this shipment (snapshot at checkout).
  commissionTiyin    BigInt            @default(0)
  /// Set by the seller when handing over to a courier service.
  carrier            String?
  trackingCode       String?
  /// When the shipment was delivered (start of the return window).
  deliveredAt        DateTime?         @db.Timestamptz(3)
  /// Customer's return request (Phase 9a).
  returnReason       ReturnReason?
  returnComment      String?
  /// Seller/staff note on the return decision (required when rejecting).
  returnDecisionNote String?
  /// Food, UZGO delivery: the courier who took the order and their fee.
  courierId          String?           @db.Uuid
  courier            User?             @relation("CourierOrders", fields: [courierId], references: [id], onDelete: Restrict)
  courierFeeTiyin    BigInt            @default(0)
  courierAssignedAt  DateTime?         @db.Timestamptz(3)
  /// Food: when the restaurant accepted (cooking) and when the food was ready.
  acceptedAt         DateTime?         @db.Timestamptz(3)
  readyAt            DateTime?         @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  items              OrderItem[]
  events             OrderEvent[]
  refunds            Refund[]

  @@index([orderId])
  @@index([storeId, status, createdAt])
  @@index([courierId, status])
}

/// Snapshot of what was bought: later product edits never change orders.
model OrderItem {
  id             String          @id @default(uuid(7)) @db.Uuid
  sellerOrderId  String          @db.Uuid
  sellerOrder    SellerOrder     @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  /// Marketplace line (exactly one of variantId / menuItemId is set).
  variantId      String?         @db.Uuid
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productId      String?         @db.Uuid
  /// Food line (Phase 9b).
  menuItemId     String?         @db.Uuid
  menuItem       FoodMenuItem?   @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  /// Marketplace: product slug; food: "" (no product page).
  productSlug    String
  title          Json
  /// Variant option labels at order time, e.g. [{uz:"128 GB",ru:"128 ГБ"}]
  options        Json
  sku            String
  unitPriceTiyin BigInt
  quantity       Int
  lineTotalTiyin BigInt
  /// Share of the promo discount on this line (fiscal receipt, refunds).
  discountTiyin  BigInt          @default(0)
  mxikCode       String?
  packageCode    String?
  vatRateBp      Int?
  /// Commission rate applied to this line (snapshot).
  commissionBp   Int             @default(0)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)

  @@index([sellerOrderId])
  @@index([variantId])
  @@index([menuItemId])
}

/// Append-only history of every status change (who, when, from, to).
model OrderEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  orderId       String       @db.Uuid
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerOrderId String?      @db.Uuid
  sellerOrder   SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  actorId       String?      @db.Uuid
  actor         User?        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorType     OrderActor
  fromStatus    String?
  toStatus      String
  reason        String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([orderId, createdAt])
  @@index([sellerOrderId])
}

/// Replay protection for order creation and payment operations (SPEC §6.9).
model IdempotencyKey {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       String
  key         String
  requestHash String
  /// Stored response replayed for repeats of the same request.
  response    Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, scope, key])
  @@index([createdAt])
}

// ─── Refunds, ledger, payouts (Phase 6d, ADR 0018) ──────────────────────────

enum RefundStatus {
  PENDING // to be returned through the provider (cabinet / API) by staff
  SUCCEEDED
  FAILED
  CANCELLED // superseded, e.g. by a full refund initiated by the provider
}

/// Money returned to a customer for an online-paid shipment or order.
model Refund {
  id               String         @id @default(uuid(7)) @db.Uuid
  orderId          String         @db.Uuid
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// Null when the provider returned the whole payment at once.
  sellerOrderId    String?        @db.Uuid
  sellerOrder      SellerOrder?   @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  paymentAttemptId String         @db.Uuid
  paymentAttempt   PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  amountTiyin      BigInt
  status           RefundStatus   @default(PENDING)
  /// Why: shipment_cancelled, delivery_failed, returned, provider_full_refund.
  reason           String
  /// Provider / bank reference entered by staff.
  reference        String?
  processedById    String?        @db.Uuid
  processedAt      DateTime?      @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([orderId])
  @@index([sellerOrderId])
}

enum LedgerAccount {
  /// Money held at the payment providers / UZGO bank account.
  PROVIDER_CLEARING
  /// Customers' money for goods not delivered yet (liability).
  CUSTOMER_PREPAYMENTS
  /// What UZGO owes each store (per storeId; negative = the store owes UZGO).
  SELLER_PAYABLE
  /// UZGO commission income.
  PLATFORM_REVENUE
  /// UZGO-funded promo discounts (expense).
  PLATFORM_PROMOTIONS
  /// What UZGO owes each courier (per courierId; negative = the courier holds UZGO's cash).
  COURIER_PAYABLE
  /// What UZGO owes each driver (per driverId; negative = the driver owes UZGO commission).
  DRIVER_PAYABLE
}

/// Double-entry ledger: every journal (journalId) sums to zero. Positive
/// amounts are debits, negative are credits. Append-only (trigger).
model LedgerEntry {
  id            String        @id @default(uuid(7)) @db.Uuid
  journalId     String        @db.Uuid
  account       LedgerAccount
  storeId       String?       @db.Uuid
  store         Store?        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  courierId     String?       @db.Uuid
  courier       User?         @relation("CourierLedger", fields: [courierId], references: [id], onDelete: Restrict)
  driverId      String?       @db.Uuid
  driver        User?         @relation("DriverLedger", fields: [driverId], references: [id], onDelete: Restrict)
  amountTiyin   BigInt
  /// payment_captured, shipment_delivered, cod_commission, return_reversal, refund, payout
  kind          String
  orderId       String?       @db.Uuid
  sellerOrderId String?       @db.Uuid
  refundId      String?       @db.Uuid
  payoutId      String?       @db.Uuid
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)

  @@index([journalId])
  @@index([account, storeId, createdAt])
  @@index([account, courierId, createdAt])
  @@index([account, driverId, createdAt])
  @@index([sellerOrderId])
}

enum PayoutStatus {
  PENDING
  PAID
  CANCELLED
}

/// Transfer of a store's earnings to its bank account (made by staff).
model Payout {
  id           String       @id @default(uuid(7)) @db.Uuid
  storeId      String       @db.Uuid
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  amountTiyin  BigInt
  status       PayoutStatus @default(PENDING)
  /// Bank details at the time of the payout (snapshot).
  bankSnapshot Json
  reference    String?
  createdById  String       @db.Uuid
  paidById     String?      @db.Uuid
  paidAt       DateTime?    @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  @@index([storeId, status])
}

// ─── Delivery and notifications (Phase 6e, ADR 0019) ───────────────────────

enum DeliveryType {
  COURIER
  PICKUP
}

/// Courier delivery price per district (per shipment). No zone = price agreed
/// with the seller (fee 0); an inactive zone = no courier delivery there.
model DeliveryZone {
  id            String   @id @default(uuid(7)) @db.Uuid
  districtId    String   @unique @db.Uuid
  district      District @relation(fields: [districtId], references: [id], onDelete: Restrict)
  feeTiyin      BigInt
  /// Free delivery for shipments from this amount (items total), if set.
  freeFromTiyin BigInt?
  etaDaysMin    Int
  etaDaysMax    Int
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
}

model PickupPoint {
  id         String   @id @default(uuid(7)) @db.Uuid
  districtId String   @db.Uuid
  district   District @relation(fields: [districtId], references: [id], onDelete: Restrict)
  name       Json
  address    String
  hours      String?
  phone      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  orders     Order[]

  @@index([districtId, active])
}

enum NotificationChannel {
  SMS
  TELEGRAM
  /// Mobile push to every device of a user (recipient = user id).
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// Outbox: written in the same transaction as the event, sent by a background
/// job with retries, so a provider outage never loses or blocks an order.
model Notification {
  id            String              @id @default(uuid(7)) @db.Uuid
  channel       NotificationChannel
  /// E.164 phone (SMS), Telegram chat id or user id (PUSH).
  recipient     String
  text          String
  /// PUSH only: deep-link payload for the app, e.g. {"type":"order","number":"UZ-…"}.
  data          Json?
  /// e.g. order.paid, shipment.status, seller.new_order
  template      String
  orderId       String?             @db.Uuid
  status        NotificationStatus  @default(PENDING)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now()) @db.Timestamptz(3)
  lastError     String?
  sentAt        DateTime?           @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([orderId])
}

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  DAMAGED_IN_DELIVERY
  CHANGED_MIND
  OTHER
}

/// A customer's saved product (Phase 9a).
model Favorite {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, productId])
  @@index([userId, createdAt])
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

/// Product review by a customer who received the product (Phase 9a).
/// Rating 1–5 (CHECK in the migration); one review per customer and product.
model ProductReview {
  id             String       @id @default(uuid(7)) @db.Uuid
  productId      String       @db.Uuid
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating         Int
  text           String?
  status         ReviewStatus @default(PUBLISHED)
  /// Moderator's reason for hiding (shown to staff only).
  moderationNote String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  @@index([status, createdAt])
}

enum PromoKind {
  PERCENT
  FIXED
}

/// UZGO-funded promo code (Phase 9a, ADR 0023). Discounts apply to items,
/// never to delivery; usage is counted over orders that were not cancelled.
model PromoCode {
  id               String    @id @default(uuid(7)) @db.Uuid
  /// Upper-case A–Z, 0–9 and "-".
  code             String    @unique
  kind             PromoKind
  /// PERCENT: basis points (1000 = 10 %).
  percentBp        Int?
  /// FIXED: amount in tiyin.
  amountTiyin      BigInt?
  /// PERCENT: optional cap in tiyin.
  maxDiscountTiyin BigInt?
  minOrderTiyin    BigInt    @default(0)
  startsAt         DateTime? @db.Timestamptz(3)
  endsAt           DateTime? @db.Timestamptz(3)
  usageLimit       Int?
  perUserLimit     Int       @default(1)
  active           Boolean   @default(true)
  description      String?
  createdById      String?   @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  orders           Order[]

  @@index([active, code])
}

// ─── UZGO Food (Phase 9b, ADR 0024) ─────────────────────────────────────────

model RestaurantProfile {
  storeId              String           @id @db.Uuid
  store                Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  address              String
  lat                  Float
  lng                  Float
  phone                String?
  deliveryMode         FoodDeliveryMode
  /// Delivery area: straight-line distance from the restaurant, metres.
  deliveryRadiusM      Int              @default(5000)
  /// SELF mode: the restaurant's delivery fee.
  selfDeliveryFeeTiyin BigInt           @default(0)
  minOrderTiyin        BigInt           @default(0)
  /// Typical cooking time shown to customers.
  prepMinutes          Int              @default(25)
  /// Weekly hours in Tashkent time: [{ day: 0–6 (Mon=0), open: "09:00", close: "23:00" }].
  openingHours         Json
  /// The team can pause new orders (busy kitchen) without staff.
  acceptingOrders      Boolean          @default(true)
  coverKey             String?
  createdAt            DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(3)
}

model FoodMenuCategory {
  id        String         @id @default(uuid(7)) @db.Uuid
  storeId   String         @db.Uuid
  store     Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  name      Json
  sort      Int            @default(0)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  items     FoodMenuItem[]

  @@index([storeId, sort])
}

model FoodMenuItem {
  id          String           @id @default(uuid(7)) @db.Uuid
  storeId     String           @db.Uuid
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  categoryId  String           @db.Uuid
  category    FoodMenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name        Json
  description Json?
  priceTiyin  BigInt
  imageKey    String?
  /// Off for today (sold out) — set by the restaurant team.
  available   Boolean          @default(true)
  /// Removed from the menu by staff (kept for past orders).
  archived    Boolean          @default(false)
  sort        Int              @default(0)
  mxikCode    String?
  packageCode String?
  vatRateBp   Int?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  orderItems  OrderItem[]

  @@index([storeId, archived, sort])
}

enum CourierStatus {
  ACTIVE
  SUSPENDED
}

enum CourierVehicle {
  FOOT
  BICYCLE
  SCOOTER
  CAR
}

model CourierProfile {
  userId     String         @id @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  status     CourierStatus  @default(ACTIVE)
  vehicle    CourierVehicle @default(SCOOTER)
  /// Ready to take offers.
  online     Boolean        @default(false)
  /// Last known position (no history is kept).
  lastLat    Float?
  lastLng    Float?
  lastSeenAt DateTime?      @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(3)

  @@index([status, online])
}

/// Cash handed in by a courier (negative) or paid out to them (positive).
model CourierSettlement {
  id          String   @id @default(uuid(7)) @db.Uuid
  courierId   String   @db.Uuid
  courier     User     @relation("SettlementCourier", fields: [courierId], references: [id], onDelete: Restrict)
  amountTiyin BigInt
  note        String?
  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([courierId, createdAt])
}

// ─── UZGO Go (Phase 9c, ADR 0025) ─────────────────────────────────────────────

enum DriverStatus {
  /// Applied, waiting for staff.
  PENDING
  ACTIVE
  /// Staff rejected the application (reviewNote says why); the driver may re-apply.
  REJECTED
  SUSPENDED
}

enum RideClass {
  ECONOMY
  COMFORT
}

model DriverProfile {
  userId          String       @id @db.Uuid
  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  status          DriverStatus @default(PENDING)
  firstName       String
  lastName        String
  /// Driver licence (haydovchilik guvohnomasi) number.
  licenceNumber   String
  /// Taxi permit or self-employed registration number, when the driver has one.
  permitNumber    String?
  /// Tax id (STIR/PINFL) for receipts and payouts, optional.
  taxId           String?
  carMake         String
  carModel        String
  carColor        String
  carYear         Int
  /// Normalised: upper case, no spaces, e.g. 01A123BC.
  plateNumber     String       @unique
  rideClass       RideClass    @default(ECONOMY)
  termsAcceptedAt DateTime     @db.Timestamptz(3)
  reviewNote      String?
  reviewedById    String?      @db.Uuid
  reviewedAt      DateTime?    @db.Timestamptz(3)
  /// Ready to take requests.
  online          Boolean      @default(false)
  /// Last known position (no history is kept).
  lastLat         Float?
  lastLng         Float?
  lastSeenAt      DateTime?    @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  @@index([status, online])
}

enum RideStatus {
  AWAITING_PAYMENT
  SEARCHING
  ACCEPTED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_DRIVER
}

/// One ride; its Order (kind RIDE) carries the number, payment and refunds.
model Ride {
  id              String      @id @default(uuid(7)) @db.Uuid
  orderId         String      @unique @db.Uuid
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  riderId         String      @db.Uuid
  rider           User        @relation("RideRider", fields: [riderId], references: [id], onDelete: Restrict)
  driverId        String?     @db.Uuid
  driver          User?       @relation("RideDriver", fields: [driverId], references: [id], onDelete: Restrict)
  rideClass       RideClass
  status          RideStatus
  pickupLat       Float
  pickupLng       Float
  pickupLabel     String
  dropoffLat      Float
  dropoffLng      Float
  dropoffLabel    String
  /// Straight-line distance between the points, metres.
  distanceM       Int
  etaMinutes      Int
  priceTiyin      BigInt
  /// UZGO commission (snapshot at ordering).
  commissionTiyin BigInt
  /// Set when SEARCHING starts (payment captured, or at once for cash).
  searchingAt     DateTime?   @db.Timestamptz(3)
  acceptedAt      DateTime?   @db.Timestamptz(3)
  arrivedAt       DateTime?   @db.Timestamptz(3)
  startedAt       DateTime?   @db.Timestamptz(3)
  finishedAt      DateTime?   @db.Timestamptz(3)
  cancelledBy     OrderActor?
  cancelReason    String?
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)

  @@index([status, searchingAt])
  @@index([riderId, createdAt])
  @@index([driverId, status])
}

/// Commission handed in by a driver (negative) or a payout to them (positive).
model DriverSettlement {
  id          String   @id @default(uuid(7)) @db.Uuid
  driverId    String   @db.Uuid
  driver      User     @relation("SettlementDriver", fields: [driverId], references: [id], onDelete: Restrict)
  amountTiyin BigInt
  note        String?
  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([driverId, createdAt])
}
