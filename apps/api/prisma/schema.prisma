// UZGO — the only Prisma schema (see docs/decisions/0002-prisma-in-api.md).
// Conventions: docs/DATABASE.md (UUID v7 ids, timestamptz, Json per-locale names).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// The pg_trgm extension is created in a migration (product search).
datasource db {
  provider = "postgresql"
}

// ─── Geography (reference data, seeded) ────────────────────────────────────

enum RegionKind {
  REGION // viloyat
  REPUBLIC // Qoraqalpogʻiston Respublikasi
  CITY // Toshkent shahri
}

enum DistrictKind {
  DISTRICT // tuman
  CITY // city of regional significance
}

model Region {
  id        String     @id @default(uuid(7)) @db.Uuid
  /// ISO 3166-2 code, e.g. UZ-SU
  code      String     @unique
  slug      String     @unique
  kind      RegionKind
  /// { "uz": "...", "ru": "..." }
  name      Json
  sort      Int
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)
  districts District[]
}

model District {
  id        String        @id @default(uuid(7)) @db.Uuid
  regionId  String        @db.Uuid
  region    Region        @relation(fields: [regionId], references: [id], onDelete: Restrict)
  slug      String        @unique
  kind      DistrictKind
  name      Json
  sort      Int
  active    Boolean       @default(true)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  profiles  UserProfile[]
  stores    Store[]
  orders    Order[]

  @@index([regionId, sort])
}

// ─── Users, roles, sessions ────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum Role {
  CUSTOMER
  SELLER_OWNER // store-scoped via membership (Phase 5)
  SELLER_STAFF // store-scoped via membership (Phase 5)
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

model User {
  id              String           @id @default(uuid(7)) @db.Uuid
  /// E.164, e.g. +998901234567
  phone           String           @unique
  status          UserStatus       @default(ACTIVE)
  locale          String           @default("uz")
  lastLoginAt     DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?        @db.Timestamptz(3)
  profile         UserProfile?
  roles           UserRole[]       @relation("UserRoles")
  rolesGranted    UserRole[]       @relation("RoleGrantedBy")
  sessions        Session[]
  auditEvents     AuditEvent[]
  storeMembers    StoreMember[]
  cart            Cart?
  orders          Order[]
  orderEvents     OrderEvent[]
  idempotencyKeys IdempotencyKey[]
}

model UserProfile {
  userId     String    @id @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName  String?
  lastName   String?
  districtId String?   @db.Uuid
  district   District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@index([districtId])
}

model UserRole {
  userId      String   @db.Uuid
  user        User     @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role        Role
  grantedById String?  @db.Uuid
  grantedBy   User?    @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, role])
  @@index([grantedById])
}

model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the opaque token; the token itself is never stored.
  tokenHash  String    @unique
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  /// HMAC of the client IP (privacy: raw IPs are not stored).
  ipHash     String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

model OtpCode {
  id         String    @id @default(uuid(7)) @db.Uuid
  phone      String
  /// HMAC-SHA256(secret, phone:code); the code itself is never stored.
  codeHash   String
  expiresAt  DateTime  @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @db.Timestamptz(3)
  ipHash     String
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@index([ipHash, createdAt])
}

// ─── Audit (append-only; UPDATE/DELETE blocked by a trigger) ────────────────

model AuditEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  /// e.g. auth.login, auth.logout, role.granted
  action     String
  entityType String
  entityId   String?
  /// Masked details only — never secrets, codes or full phone numbers.
  metadata   Json?
  ipHash     String?
  requestId  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

// ─── Catalog (Phase 4) ─────────────────────────────────────────────────────

model Category {
  id         String              @id @default(uuid(7)) @db.Uuid
  parentId   String?             @db.Uuid
  parent     Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]          @relation("CategoryTree")
  slug       String              @unique
  /// { "uz": "...", "ru": "..." }
  name       Json
  /// Icon name used by the web app (lucide), e.g. "smartphone"
  icon       String?
  sort       Int                 @default(0)
  active     Boolean             @default(true)
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @db.Timestamptz(3)
  attributes CategoryAttribute[]
  products   Product[]

  @@index([parentId, sort])
}

enum AttributeType {
  SELECT
}

model Attribute {
  id         String              @id @default(uuid(7)) @db.Uuid
  code       String              @unique
  name       Json
  type       AttributeType       @default(SELECT)
  sort       Int                 @default(0)
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @db.Timestamptz(3)
  values     AttributeValue[]
  categories CategoryAttribute[]
}

model AttributeValue {
  id          String                  @id @default(uuid(7)) @db.Uuid
  attributeId String                  @db.Uuid
  attribute   Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  code        String
  name        Json
  sort        Int                     @default(0)
  createdAt   DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                @updatedAt @db.Timestamptz(3)
  products    ProductAttributeValue[]
  variants    VariantAttributeValue[]

  @@unique([attributeId, code])
}

/// Which attributes a category uses for filters (inherited by its children).
model CategoryAttribute {
  categoryId  String    @db.Uuid
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attributeId String    @db.Uuid
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  sort        Int       @default(0)

  @@id([categoryId, attributeId])
  @@index([attributeId])
}

// ─── Stores and products (Phase 4) ─────────────────────────────────────────

enum StoreStatus {
  PENDING // created, awaiting approval (Phase 5 onboarding)
  ACTIVE
  SUSPENDED
}

model Store {
  id           String           @id @default(uuid(7)) @db.Uuid
  slug         String           @unique
  name         Json
  description  Json?
  status       StoreStatus      @default(PENDING)
  /// Demo stores (seeded fixtures) are labelled "Demo" everywhere in the UI.
  isDemo       Boolean          @default(false)
  districtId   String?          @db.Uuid
  district     District?        @relation(fields: [districtId], references: [id], onDelete: SetNull)
  logoKey      String?
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?        @db.Timestamptz(3)
  members      StoreMember[]
  products     Product[]
  variants     ProductVariant[]
  sellerOrders SellerOrder[]

  @@index([status])
  @@index([districtId])
}

enum StoreRole {
  OWNER
  STAFF
}

/// Store-scoped seller roles (SPEC §9). Seller isolation is checked against this table.
model StoreMember {
  storeId   String    @db.Uuid
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      StoreRole
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@id([storeId, userId])
  @@index([userId])
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

model Product {
  id           String                   @id @default(uuid(7)) @db.Uuid
  storeId      String                   @db.Uuid
  store        Store                    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  categoryId   String                   @db.Uuid
  category     Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  slug         String                   @unique
  title        Json
  description  Json
  status       ProductStatus            @default(DRAFT)
  /// Normalised text for search (uz + ru titles, Latin/Cyrillic folded, apostrophes removed).
  searchText   String                   @default("")
  /// GENERATED ALWAYS AS (to_tsvector('simple', "searchText")) STORED — see migration.
  searchVector Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, \"searchText\")"))
  createdAt    DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                 @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?                @db.Timestamptz(3)
  variants     ProductVariant[]
  images       ProductImage[]
  attributes   ProductAttributeValue[]

  @@index([status, categoryId])
  @@index([storeId, status])
  @@index([categoryId])
  @@index([searchVector], type: Gin)
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Product-level attribute values (e.g. brand) used for filters.
model ProductAttributeValue {
  productId        String         @db.Uuid
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValueId String         @db.Uuid
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([productId, attributeValueId])
  @@index([attributeValueId])
}

/// SKU: price, stock and fiscal data live on the variant (SPEC §10).
model ProductVariant {
  id                  String                  @id @default(uuid(7)) @db.Uuid
  productId           String                  @db.Uuid
  product             Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Denormalised from Product so SKUs are unique per store.
  storeId             String                  @db.Uuid
  store               Store                   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  sku                 String
  barcode             String?
  /// Integer tiyin (1 soʻm = 100 tiyin).
  priceTiyin          BigInt
  compareAtPriceTiyin BigInt?
  stock               Int                     @default(0)
  /// MXIK / IKPU product classification code (17 digits). Required before online payments.
  mxikCode            String?
  packageCode         String?
  /// VAT in basis points, e.g. 1200 = 12 %.
  vatRateBp           Int?
  active              Boolean                 @default(true)
  sort                Int                     @default(0)
  createdAt           DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @db.Timestamptz(3)
  options             VariantAttributeValue[]
  cartItems           CartItem[]
  orderItems          OrderItem[]

  @@unique([storeId, sku])
  @@index([productId])
  @@index([priceTiyin])
}

/// Variant options (e.g. colour, size, memory).
model VariantAttributeValue {
  variantId        String         @db.Uuid
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValueId String         @db.Uuid
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
}

model ProductImage {
  id         String   @id @default(uuid(7)) @db.Uuid
  productId  String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Random object-storage key; never a user-supplied path.
  storageKey String   @unique
  sort       Int      @default(0)
  alt        Json?
  width      Int?
  height     Int?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([productId, sort])
}

// ─── Cart (Phase 4e) ───────────────────────────────────────────────────────

/// One cart per user, or a guest cart identified by a hashed cookie token.
/// Prices are never stored here: they are recalculated on every read.
model Cart {
  id             String     @id @default(uuid(7)) @db.Uuid
  userId         String?    @unique @db.Uuid
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the guest cart cookie token.
  guestTokenHash String?    @unique
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)
  items          CartItem[]

  @@index([updatedAt])
}

model CartItem {
  id        String         @id @default(uuid(7)) @db.Uuid
  cartId    String         @db.Uuid
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String         @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([cartId, variantId])
  @@index([variantId])
}

// ─── Orders (Phase 4f) — never deleted (trigger) ───────────────────────────

enum OrderStatus {
  CREATED // cash/card on delivery, waiting for sellers
  CONFIRMED // at least one seller accepted
  COMPLETED // every shipment resolved
  CANCELLED // every shipment cancelled
}

enum SellerOrderStatus {
  NEW
  ACCEPTED
  PACKED
  HANDED_TO_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  CANCELLED_BY_SELLER
  CANCELLED_BY_CUSTOMER
  RETURN_REQUESTED
  RETURNED
  RETURN_REJECTED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
}

enum OrderActor {
  CUSTOMER
  SELLER
  ADMIN
  SYSTEM
}

/// Customer-facing order; one SellerOrder (shipment) per store (ADR 0006).
model Order {
  id                 String        @id @default(uuid(7)) @db.Uuid
  /// Human-readable, e.g. UZ-2026-000123
  number             String        @unique
  userId             String        @db.Uuid
  user               User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  status             OrderStatus   @default(CREATED)
  paymentMethod      PaymentMethod
  itemsTotalTiyin    BigInt
  deliveryTotalTiyin BigInt
  totalTiyin         BigInt
  recipientName      String
  recipientPhone     String
  districtId         String        @db.Uuid
  district           District      @relation(fields: [districtId], references: [id], onDelete: Restrict)
  addressLine        String
  /// Region/district names at order time.
  addressSnapshot    Json
  comment            String?
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)
  sellerOrders       SellerOrder[]
  events             OrderEvent[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([districtId])
}

model SellerOrder {
  id              String            @id @default(uuid(7)) @db.Uuid
  orderId         String            @db.Uuid
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  storeId         String            @db.Uuid
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  /// e.g. UZ-2026-000123-1
  number          String            @unique
  status          SellerOrderStatus @default(NEW)
  itemsTotalTiyin BigInt
  deliveryTiyin   BigInt
  totalTiyin      BigInt
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  items           OrderItem[]
  events          OrderEvent[]

  @@index([orderId])
  @@index([storeId, status, createdAt])
}

/// Snapshot of what was bought: later product edits never change orders.
model OrderItem {
  id             String         @id @default(uuid(7)) @db.Uuid
  sellerOrderId  String         @db.Uuid
  sellerOrder    SellerOrder    @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  variantId      String         @db.Uuid
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productId      String         @db.Uuid
  productSlug    String
  title          Json
  /// Variant option labels at order time, e.g. [{uz:"128 GB",ru:"128 ГБ"}]
  options        Json
  sku            String
  unitPriceTiyin BigInt
  quantity       Int
  lineTotalTiyin BigInt
  mxikCode       String?
  packageCode    String?
  vatRateBp      Int?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  @@index([sellerOrderId])
  @@index([variantId])
}

/// Append-only history of every status change (who, when, from, to).
model OrderEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  orderId       String       @db.Uuid
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerOrderId String?      @db.Uuid
  sellerOrder   SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  actorId       String?      @db.Uuid
  actor         User?        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorType     OrderActor
  fromStatus    String?
  toStatus      String
  reason        String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([orderId, createdAt])
  @@index([sellerOrderId])
}

/// Replay protection for order creation and payment operations (SPEC §6.9).
model IdempotencyKey {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       String
  key         String
  requestHash String
  /// Stored response replayed for repeats of the same request.
  response    Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, scope, key])
  @@index([createdAt])
}
