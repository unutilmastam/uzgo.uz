# apps/api environment. Copy to apps/api/.env for local development.
# Placeholders only — never commit real secrets.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# PostgreSQL connection (docker-compose.yml uses these placeholder credentials).
DATABASE_URL=postgresql://uzgo:uzgo_dev_password@localhost:5432/uzgo?schema=public

# Comma-separated list of browser origins allowed to call the API.
# Production: https origins only.
CORS_ORIGINS=http://localhost:3000

# Max JSON request body size.
BODY_LIMIT=1mb

# Swagger UI at /api/docs. Defaults to on outside production, off in production.
# SWAGGER_ENABLED=false

# Set to the number of trusted reverse-proxy hops in production (e.g. 1).
TRUST_PROXY=0

# Secret for hashing OTP codes and client IPs (HMAC). At least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-at-least-32-random-characters

# SMS provider. "dev" prints codes to the console and works ONLY with NODE_ENV=development.
# "eskiz" = Eskiz.uz gateway (production). Message texts must be approved in the Eskiz cabinet.
SMS_PROVIDER=dev
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=
# ESKIZ_FROM=4546
# ESKIZ_BASE_URL=https://notify.eskiz.uz/api

# Max OTP requests per client IP per hour.
OTP_IP_HOURLY_LIMIT=20

# Image storage. "local" writes to STORAGE_LOCAL_DIR. In production this must be an
# absolute path on a persistent, backed-up volume (ADR 0020), e.g. /data/uploads.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
MEDIA_PUBLIC_BASE_URL=/api/v1/media

# Encrypts staff TOTP secrets (32 random bytes, base64). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=replace-with-32-random-bytes-base64
# Staff second factor (always true in production).
STAFF_TOTP_REQUIRED=true
# Browser e2e only: disables the per-IP request throttler. Refused unless NODE_ENV=test.
# RATE_LIMIT_DISABLED=false

# ─── Online payments (ADR 0017) ─────────────────────────────────────────────
# Unpaid online orders are cancelled (stock released) after this many minutes.
PAYMENT_WINDOW_MINUTES=30
# Public web origin for payment return URLs (defaults to the first CORS origin).
# WEB_PUBLIC_URL=https://uzgo.uz
# DEVELOPMENT ONLY: simulated online payment ("Test toʻlov"). Refused in production.
DEV_PAYMENTS_ENABLED=true
# Payme Merchant API — the method is offered only when both are set.
# PAYME_MERCHANT_ID=
# PAYME_KEY=
# PAYME_CHECKOUT_URL=https://checkout.paycom.uz
# Click SHOP API — the method is offered only when all four are set.
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_MERCHANT_USER_ID=
# CLICK_SECRET_KEY=

# ─── Ledger and payouts (ADR 0018) ──────────────────────────────────────────
# Commission when neither the store nor its category sets one (basis points, 1000 = 10 %).
COMMISSION_DEFAULT_BP=0
# Delivered earnings stay on hold this many days (return window) before payout.
PAYOUT_HOLD_DAYS=10

# ─── Notifications (ADR 0019) ───────────────────────────────────────────────
# Telegram bot token for seller notifications (without it messages are only logged).
# TELEGRAM_BOT_TOKEN=
