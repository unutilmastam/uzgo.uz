# apps/web environment. Copy to apps/web/.env.local for local development.
# Placeholders only — never commit real secrets.

# Base URL the Next.js server uses to call the API server-to-server.
API_INTERNAL_URL=http://localhost:4000

# Public origin of the site (sitemap, canonical URLs).
PUBLIC_SITE_URL=http://localhost:3000
# Allow search engines (only after launch).
PUBLIC_INDEXING=false
# Same value as the API's INTERNAL_API_TOKEN (production; per-visitor rate limits).
# INTERNAL_API_TOKEN=
