{
  "name": "@uzgo/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bundle": "expo export --platform android --platform ios --output-dir dist --no-minify",
    "e2e": "EXPO_PUBLIC_API_URL= EXPO_OFFLINE=1 expo export --platform web --output-dir dist-web && playwright test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@uzgo/contracts": "workspace:*",
    "@uzgo/ui": "workspace:*",
    "expo": "~57.0.28",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-device": "~57.0.2",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.27",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@react-native/metro-config": "0.88.0",
    "@types/react": "~19.3.0",
    "@uzgo/config": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
